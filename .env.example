# Railway provides PORT automatically. Keep this for local production testing.
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL connection string. Railway PostgreSQL exposes this as DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/database

# Discord bot token. Never commit the real value.
DISCORD_BOT_TOKEN=

# Discord User ID that receives status alerts and can use the owner-only DM AI.
OWNER_ID=

# Shared Owner AI, Server AI, ticket AI, and staff-summary provider selection.
# OpenAI uses OPENAI_API_KEY when AI_API_KEY is empty for compatibility.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30000
AI_MAX_HISTORY=20
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_PENDING_REQUESTS=3
# Optional provider endpoint overrides. Required for non-OpenAI providers when
# you do not want to use the provider's configured default endpoint.
AI_BASE_URL=
AI_OPENAI_BASE_URL=
AI_GEMINI_BASE_URL=
AI_CLAUDE_BASE_URL=
AI_GROQ_BASE_URL=

# Compatibility fallback for existing OpenAI ticket deployments.
OPENAI_API_KEY=